        async function saveNewEmail(e) {
            e.preventDefault();
            if (!currentObserver) return;
            
            const newEmail = document.getElementById('newEmail').value.trim();
            const confirmPw = document.getElementById('confirmPwEmail').value;
            
            if (confirmPw !== currentObserver.password) {
                showToast('Password konfirmasi salah!', 'error');
                return;
            }
            
            if (newEmail === currentObserver.email) {
                showToast('Email baru sama dengan email lama.', 'info');
                return;
            }
            
            showLoading();
            try {
                if (currentObserver.id && currentObserver.id !== 'local-default') {
                    const { error } = await _supabase
                        .from('observer')
                        .update({ email: newEmail })
                        .eq('id', currentObserver.id);
                    if (error) throw error;
                } else {
                    const { error } = await _supabase
                        .from('observer')
                        .insert({
                            nama: currentObserver.nama,
                            nip: currentObserver.nip,
                            sekolah: currentObserver.sekolah,
                            email: newEmail,
                            password: currentObserver.password
                        });
                    if (error) throw error;
                }
                
                currentObserver.email = newEmail;
                const auth = JSON.parse(localStorage.getItem('supervisi_auth'));
                if (auth) { auth.email = newEmail; localStorage.setItem('supervisi_auth', JSON.stringify(auth)); }
                
                await loadObserver();
                document.getElementById('formEditEmail').reset();
                showToast('✅ Email berhasil diperbarui!', 'success');
            } catch (err) {
                console.error(err);
                showToast('Gagal menyimpan email: ' + err.message, 'error');
            } finally {
                hideLoading();
            }
        }

