        let saveTimeouts = {};
        function autoSave(indikatorId, value) {
            if (!currentSesiId) return;
            clearTimeout(saveTimeouts[indikatorId]);
            saveTimeouts[indikatorId] = setTimeout(async () => {
                try {
                    const { data: existing } = await _supabase
                        .from('observasi')
                        .select('id')
                        .eq('guru_id', currentSesiId)
                        .eq('indikator_id', String(indikatorId))
                        .maybeSingle();
                    
                    if (existing) {
                        await _supabase.from('observasi').update({ catatan: value }).eq('id', existing.id);
                    } else if (value) {
                        await _supabase.from('observasi').insert({
                            guru_id: currentSesiId,
                            indikator_id: String(indikatorId),
                            catatan: value
                        });
                    }
                } catch (err) { console.error('Auto-save error:', err); }
            }, 800);
        }

        function attachAutoSave() {
            const fieldMap = {
                'formB1a': 'b1a', 'formB1b': 'b1b', 'formB2': 'b2', 'formB3': 'b3',
                'formC1': 'c1', 'formC2': 'c2', 'formC3': 'c3',
                'pascaApresiasi': 'pascaApresiasi', 'pascaFokus': 'pascaFokus',
                'pascaTantangan': 'pascaTantangan',
                'pascaRef1': 'pascaRef1', 'pascaRef2': 'pascaRef2', 'pascaRef3': 'pascaRef3'
            };
            
            // Semua 49 indikator observasi
            for (let i = 1; i <= 49; i++) {
                fieldMap['obs_' + i] = String(i);
            }
            
            Object.keys(fieldMap).forEach(id => {
                const el = document.getElementById(id);
                if (el && !el.dataset.autosaveAttached) {
                    el.dataset.autosaveAttached = 'true';
                    el.addEventListener('input', () => autoSave(fieldMap[id], el.value));
                }
            });
        }

