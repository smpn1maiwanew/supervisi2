            document.getElementById('statTotalGuru').textContent = currentGuruList.length;
            document.getElementById('statPra').textContent = currentGuruList.filter(g => g.status === 'pra').length;
            document.getElementById('statObservasi').textContent = currentGuruList.filter(g => g.status === 'observasi').length;
            document.getElementById('statSelesai').textContent = currentGuruList.filter(g => g.status === 'selesai').length;
        }

        // ============================================================
        // NAVIGASI OBSERVER
        // ============================================================
        function switchMainMenu(menu) {
            document.querySelectorAll('.menu-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('content-' + menu).classList.remove('hidden');
            
            document.querySelectorAll('[id^="menu-"]').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('tab-inactive');
            });
            document.getElementById('menu-' + menu).classList.remove('tab-inactive');
            document.getElementById('menu-' + menu).classList.add('tab-active');
            
            if (menu === 'rekap') renderRekapList();
            if (menu === 'dashboard') updateStats();
            if (menu === 'kredensial') renderKredensialInfo();
        }

        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('content-' + tabName).classList.remove('hidden');
            
            document.querySelectorAll('[id^="tab-"]').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('tab-inactive');
            });
            document.getElementById('tab-' + tabName).classList.remove('tab-inactive');
            document.getElementById('tab-' + tabName).classList.add('tab-active');
            
            if (tabName === 'observasi' || tabName === 'pra' || tabName === 'pasca') attachAutoSave();
        }

        function toggleAccordion(id) {
            const content = document.getElementById(id);
            content.classList.toggle('active');
            const icon = content.previousElementSibling.querySelector('i:last-child');
            if (content.classList.contains('active')) {
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-up');
            } else {
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            }
        }

        function closeModal(id) { document.getElementById(id).classList.remove('active'); }

        // ============================================================
        // GURU APP
        // ============================================================
        async function initGuruApp() {
            const auth = JSON.parse(localStorage.getItem('supervisi_auth'));
            if (!auth || !auth.guruId) return;
            
            showLoading();
            try {
                const { data: guru, error } = await _supabase.from('guru').select('*').eq('id', auth.guruId).single();
                if (error) throw error;
                
                document.getElementById('headerGuruName').textContent = guru.nama;
                const username = guru.username || generateUsername(guru.nama);
                document.getElementById('guruUsernameBadge').textContent = username;
                
                const fa = guru.form_a || {};
                document.getElementById('faNama').value = fa.nama || guru.nama;
                document.getElementById('faNip').value = fa.nip || '';
                document.getElementById('faMapel').value = fa.mapel || '';
                document.getElementById('faKelas').value = fa.kelas || '';
                document.getElementById('faMateri').value = fa.materi || '';
                document.getElementById('faTanggal').value = fa.tanggal || '';
                document.getElementById('faAlokasi').value = fa.alokasi || '';
                document.getElementById('faJadwal').value = fa.jadwal || '';
                document.getElementById('faFokus').value = fa.fokus || 'Pembelajaran Mendalam (Deep Learning)';
                
                document.getElementById('faObserver').value = currentObserver ? currentObserver.nama : '-';
                
                renderGuruStatusInfo(guru);
                await renderRTLListGuru(guru.id);
            } catch (err) {
                console.error(err);
                showToast('Gagal memuat data: ' + err.message, 'error');
            } finally {
                hideLoading();
            }
        }

        function renderGuruStatusInfo(guru) {
            const status = getStatusLabel(guru.status);
            const container = document.getElementById('guruStatusInfo');
            
            const steps = [
                { key: 'pra', label: 'Pra-Observasi', icon: 'fa-clipboard-list', desc: 'Isi Form A & telaah perencanaan' },
                { key: 'observasi', label: 'Observasi Kelas', icon: 'fa-eye', desc: 'Observer mencatat bukti faktual' },
                { key: 'selesai', label: 'Pasca-Observasi', icon: 'fa-comments', desc: 'Refleksi & RTL' }
            ];
            
            const statusOrder = { 'pra': 0, 'observasi': 1, 'selesai': 2 };
            const currentIdx = statusOrder[guru.status] || 0;
            
            container.innerHTML = `
                <div class="bg-gradient-to-r from-blue-50 to-white border border-blue-200 rounded-xl p-4 mb-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-gray-500">Status Saat Ini</span>
                        <span class="status-badge ${status.class}">${status.label}</span>
                    </div>
                </div>
                <div class="space-y-2">
                    ${steps.map((s, i) => `
                        <div class="flex items-center gap-3 p-3 rounded-lg ${i <= currentIdx ? 'bg-blue-50 border border-blue-200' : 'bg-gray-50 border border-gray-200'}">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center ${i <= currentIdx ? 'bg-blue-600 text-white' : 'bg-gray-300 text-gray-500'}">
                                <i class="fas ${i < currentIdx ? 'fa-check' : s.icon} text-xs"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-semibold ${i <= currentIdx ? 'text-blue-800' : 'text-gray-500'}">${s.label}</p>
                                <p class="text-xs text-gray-500">${s.desc}</p>
                            </div>
                        </div>
                    `).join('')}
                </div>
            `;
        }

        async function saveFormA(e) {
            e.preventDefault();
            const auth = JSON.parse(localStorage.getItem('supervisi_auth'));
            if (!auth || !auth.guruId) return;
            
            const formA = {
                nama: document.getElementById('faNama').value,
                nip: document.getElementById('faNip').value,
                mapel: document.getElementById('faMapel').value,
                kelas: document.getElementById('faKelas').value,
                materi: document.getElementById('faMateri').value,
                tanggal: document.getElementById('faTanggal').value,
                alokasi: document.getElementById('faAlokasi').value,
                jadwal: document.getElementById('faJadwal').value,
                fokus: document.getElementById('faFokus').value,
                observer: document.getElementById('faObserver').value,
                updatedAt: Date.now()
            };
            
            showLoading();
            try {
                const { error } = await _supabase.from('guru').update({ form_a: formA }).eq('id', auth.guruId);
                if (error) throw error;
                showToast('✅ Identitas (Form A) berhasil disimpan!', 'success');
                await initGuruApp();
            } catch (err) {
                console.error(err);
                showToast('Gagal menyimpan: ' + err.message, 'error');
            } finally {
                hideLoading();
            }
        }

        async function saveRTL(e) {
            e.preventDefault();
            const auth = JSON.parse(localStorage.getItem('supervisi_auth'));
            if (!auth || !auth.guruId) return;
            
            const { data: guru } = await _supabase.from('guru').select('status, nama').eq('id', auth.guruId).single();
            
            if (guru && (guru.status === 'pra' || guru.status === 'observasi')) {
                showToast('⚠️ RTL hanya dapat diisi setelah sesi Pasca-Observasi dimulai.', 'error');
                return;
            }
            
            const rtl = {
                guru_id: auth.guruId,
                area: document.getElementById('rtlArea').value,
                bentuk: document.getElementById('rtlBentuk').value,
                aktivitas: document.getElementById('rtlAktivitas').value,
                waktu: document.getElementById('rtlWaktu').value,
                ukuran: document.getElementById('rtlUkuran').value
            };
            
            showLoading();
            try {
                const { error } = await _supabase.from('rtl').insert(rtl);
                if (error) throw error;
                document.getElementById('formRTL').reset();
                showToast('✅ Rencana Tindak Lanjut berhasil disimpan!', 'success');
                await renderRTLListGuru(auth.guruId);
            } catch (err) {
                console.error(err);
                showToast('Gagal menyimpan RTL: ' + err.message, 'error');
            } finally {
                hideLoading();
            }
        }

        async function renderRTLListGuru(guruId) {
            const container = document.getElementById('rtlListGuru');
            const infoBox = document.getElementById('rtlInfoGuru');
            
            const { data: guru } = await _supabase.from('guru').select('status').eq('id', guruId).single();
            
            if (guru && (guru.status === 'pra' || guru.status === 'observasi')) {
                infoBox.className = 'bg-yellow-50 border-l-4 border-yellow-500 p-3 rounded-r-lg mb-4 text-xs text-yellow-800';
                infoBox.innerHTML = '<i class="fas fa-lock mr-1"></i> Form RTL akan aktif setelah Kepala Sekolah memulai tahap Pasca-Observasi.';
            } else {
                infoBox.className = 'bg-green-50 border-l-4 border-green-500 p-3 rounded-r-lg mb-4 text-xs text-green-800';
                infoBox.innerHTML = '<i class="fas fa-check-circle mr-1"></i> Anda dapat mengisi RTL di bawah ini.';
            }
            
            const { data, error } = await _supabase
                .from('rtl')
                .select('*')
                .eq('guru_id', guruId)
                .order('created_at', { ascending: false });
            
            if (error || !data || data.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-6">
                        <i class="fas fa-inbox text-gray-300 text-3xl mb-2"></i>
                        <p class="text-gray-500 text-xs">Belum ada RTL tersimpan.</p>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = data.map(r => `
                <div class="border border-blue-100 rounded-xl p-4 bg-blue-50/30">
                    <div class="flex justify-between items-start mb-2">
                        <p class="font-semibold text-sm text-blue-800">${r.area}</p>
                        <span class="badge-blue">${r.bentuk || '-'}</span>
                    </div>
                    <p class="text-xs text-gray-600 mb-2"><i class="fas fa-lightbulb text-blue-400 mr-1"></i> ${r.aktivitas || '-'}</p>
                    <div class="grid grid-cols-2 gap-2 text-xs text-gray-500">
                        <div><i class="fas fa-clock text-blue-400 mr-1"></i> ${r.waktu || '-'}</div>
                        <div><i class="fas fa-check-circle text-green-400 mr-1"></i> ${r.ukuran || '-'}</div>
                    </div>
                </div>
            `).join('');
        }

        function switchGuruMenu(menu) {
            document.querySelectorAll('.gmenu-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('gcontent-' + menu).classList.remove('hidden');
            
            document.querySelectorAll('[id^="gmenu-"]').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('tab-inactive');
            });
            document.getElementById('gmenu-' + menu).classList.remove('tab-inactive');
            document.getElementById('gmenu-' + menu).classList.add('tab-active');
        }

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', (e) => {
                if (e.target === overlay) overlay.classList.remove('active');
            });
        });

        checkAuth();
    </script>
</body>
</html>
