        async function updateStatusSesi(newStatus) {
            if (!currentSesiId) return;
            
            const guru = currentGuruList.find(g => g.id === currentSesiId);
            if (newStatus === 'observasi') {
                const fa = guru.form_a || {};
                if (!fa.nama || !fa.mapel || !fa.kelas) {
                    if (!confirm('Guru belum mengisi data identitas (Form A). Yakin ingin lanjut ke Observasi?')) return;
                }
            }
            
            showLoading();
            try {
                const { error } = await _supabase.from('guru').update({ status: newStatus }).eq('id', currentSesiId);
                if (error) throw error;
                
                const idx = currentGuruList.findIndex(g => g.id === currentSesiId);
                if (idx >= 0) currentGuruList[idx].status = newStatus;
                
                const status = getStatusLabel(newStatus);
                const badge = document.getElementById('sesiStatusBadge');
                badge.className = 'status-badge ' + status.class;
                badge.textContent = status.label;
                
                if (newStatus === 'observasi') switchTab('observasi');
                else if (newStatus === 'pasca') switchTab('pasca');
                
                renderRekapList();
                updateStats();
                showToast('Status sesi diperbarui.', 'success');
            } catch (err) {
                console.error(err);
                showToast('Gagal update status: ' + err.message, 'error');
            } finally {
                hideLoading();
            }
        }

