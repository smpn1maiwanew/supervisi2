        async function saveGuru(e) {
            e.preventDefault();
            const id = document.getElementById('guruId').value;
            const namaBaru = document.getElementById('guruNama').value.trim();
            const usernameBaru = generateUsername(namaBaru);
            const pinBaru = document.getElementById('guruPin').value;
            
            if (!usernameBaru) { showToast('Username tidak dapat di-generate dari nama ini.', 'error'); return; }
            
            const duplikatUsername = currentGuruList.find(g => g.username === usernameBaru && g.id !== id);
            if (duplikatUsername) {
                showToast(`Username "${usernameBaru}" sudah dipakai oleh ${duplikatUsername.nama}`, 'error');
                return;
            }
            
            showLoading();
            try {
                if (id) {
                    const { error } = await _supabase
                        .from('guru')
                        .update({ nama: namaBaru, username: usernameBaru, pin: pinBaru })
                        .eq('id', id);
                    if (error) throw error;
                    showToast('Data akun guru berhasil diperbarui!', 'success');
                } else {
                    const { data, error } = await _supabase
                        .from('guru')
                        .insert({ nama: namaBaru, username: usernameBaru, pin: pinBaru, status: 'pra', form_a: {} })
                        .select()
                        .single();
                    if (error) throw error;
                    window._newGuruId = data.id;
                }
                
                closeModal('guruModal');
                await refreshGuruList();
                
                if (!id) setTimeout(() => showPinModal(window._newGuruId), 300);
            } catch (err) {
                console.error(err);
                showToast('Gagal menyimpan: ' + err.message, 'error');
            } finally {
                hideLoading();
            }
        }

