<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supervisi Coaching - SMPN 1 Maiwa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        body { 
            font-family: 'Inter', system-ui, sans-serif; 
            background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
            min-height: 100vh;
        }
        .tab-active { 
            border-bottom: 3px solid #2563eb; 
            color: #2563eb; 
            font-weight: 700; 
            background: #eff6ff;
            border-radius: 8px 8px 0 0;
        }
        .tab-inactive { 
            color: #64748b; 
            border-bottom: 3px solid transparent;
        }
        .tab-inactive:hover { color: #2563eb; background: #f8fafc; }
        .accordion-content { display: none; }
        .accordion-content.active { display: block; }
        .indicator-item { transition: all 0.2s; }
        .indicator-item:focus-within { 
            background-color: #eff6ff; 
            border-left: 3px solid #2563eb;
            padding-left: 8px;
            margin-left: -11px;
        }
        .card-blue {
            background: white;
            border: 1px solid #dbeafe;
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.08), 0 2px 4px -2px rgba(37, 99, 235, 0.06);
        }
        .header-gradient {
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #3b82f6 100%);
        }
        .btn-primary {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            transition: all 0.2s;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }
        .btn-green {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            transition: all 0.2s;
        }
        .btn-green:hover {
            background: linear-gradient(135deg, #047857 0%, #065f46 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
        }
        .btn-orange {
            background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
            transition: all 0.2s;
        }
        .btn-orange:hover {
            background: linear-gradient(135deg, #c2410c 0%, #9a3412 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(234, 88, 12, 0.3);
        }
        textarea:focus, input:focus, select:focus {
            outline: none;
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }
        .badge-blue {
            background: #dbeafe;
            color: #1d4ed8;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
        }
        .badge-green {
            background: #d1fae5;
            color: #065f46;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
        }
        .badge-yellow {
            background: #fef3c7;
            color: #92400e;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
        }
        .status-badge {
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
        }
        .status-pra { background: #fef3c7; color: #92400e; }
        .status-observasi { background: #dbeafe; color: #1e40af; }
        .status-selesai { background: #d1fae5; color: #065f46; }
        
        .login-screen {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #3b82f6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 100;
            padding: 16px;
        }
        .login-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 400px;
            padding: 40px;
        }
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 90;
            padding: 16px;
        }
        .modal-overlay.active { display: flex; }
        .modal-content {
            background: white;
            border-radius: 20px;
            max-width: 600px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
        }
        .hidden-screen { display: none !important; }
        
        .login-role-tab { transition: all 0.2s; }
        .login-role-tab.active {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }
        .login-role-tab.inactive { background: #f1f5f9; color: #64748b; }
        
        .login-footer {
            text-align: center;
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px solid #e5e7eb;
        }
        .login-footer p { font-size: 11px; color: #94a3b8; line-height: 1.5; }
        .login-footer .dev-name { color: #2563eb; font-weight: 600; }
        
        .username-badge {
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
            color: #1e40af;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            font-family: 'Courier New', monospace;
        }
        
        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(2px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 200;
        }
        .loading-overlay.active { display: flex; }
        .spinner {
            width: 48px;
            height: 48px;
            border: 4px solid #dbeafe;
            border-top: 4px solid #2563eb;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .toast {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 12px 20px;
            border-radius: 12px;
            color: white;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            z-index: 300;
            animation: slideIn 0.3s ease;
        }
        .toast.success { background: linear-gradient(135deg, #059669 0%, #047857 100%); }
        .toast.error { background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); }
        .toast.info { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); }
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        @media print {
            .no-print { display: none !important; }
            body { background: white; }
            .card-blue { box-shadow: none; border: 1px solid #e5e7eb; }
        }
    </style>
</head>
<body>

    <!-- LOADING OVERLAY -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner"></div>
    </div>

    <!-- ================= LOGIN SCREEN ================= -->
    <div id="loginScreen" class="login-screen">
        <div class="login-card">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-700 rounded-2xl mb-3 shadow-lg">
                    <i class="fas fa-chalkboard-teacher text-white text-2xl"></i>
                </div>
                <h1 class="text-xl font-bold text-gray-800">Supervisi Coaching</h1>
                <p class="text-sm text-gray-500">SMP Negeri 1 Maiwa</p>
            </div>

            <div class="grid grid-cols-2 gap-2 mb-5">
                <button onclick="switchLoginRole('observer')" id="roleBtnObserver" class="login-role-tab active py-2.5 rounded-xl text-sm font-semibold">
                    <i class="fas fa-user-shield mr-1"></i> Observer
                </button>
                <button onclick="switchLoginRole('guru')" id="roleBtnGuru" class="login-role-tab inactive py-2.5 rounded-xl text-sm font-semibold">
                    <i class="fas fa-user mr-1"></i> Guru
                </button>
            </div>

            <div id="loginFormObserver" class="space-y-4">
                <div>
                    <label class="text-sm font-medium text-gray-700 mb-1 block">Email</label>
                    <div class="relative">
                        <i class="fas fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="email" id="loginEmail" value="kepsek@smpn1maiwa.sch.id" class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm" placeholder="email@sekolah.id">
                    </div>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700 mb-1 block">Password</label>
                    <div class="relative">
                        <i class="fas fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="password" id="loginPassword" value="admin123" class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm" placeholder="••••••••">
                    </div>
                </div>
                <button onclick="handleLoginObserver()" class="btn-primary w-full text-white py-3 rounded-xl text-sm font-semibold">
                    <i class="fas fa-sign-in-alt mr-2"></i> Masuk sebagai Observer
                </button>
            </div>

            <div id="loginFormGuru" class="space-y-4 hidden">
                <div>
                    <label class="text-sm font-medium text-gray-700 mb-1 block">Username</label>
                    <div class="relative">
                        <i class="fas fa-user absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="text" id="loginGuruNama" class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm" placeholder="username (cth: budisantoso)">
                    </div>
                    <p class="text-xs text-gray-400 mt-1"><i class="fas fa-info-circle"></i> Username: nama tanpa gelar, huruf kecil, tanpa spasi</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700 mb-1 block">PIN (6 digit)</label>
                    <div class="relative">
                        <i class="fas fa-key absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="password" id="loginGuruPin" maxlength="6" class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm tracking-widest" placeholder="••••••">
                    </div>
                </div>
                <button onclick="handleLoginGuru()" class="btn-green w-full text-white py-3 rounded-xl text-sm font-semibold">
                    <i class="fas fa-sign-in-alt mr-2"></i> Masuk sebagai Guru
                </button>
            </div>

            <div class="login-footer">
                <p>Dikembangkan oleh:</p>
                <p class="dev-name">Darmawati, S.Pd., M.Pd.</p>
                <p>Guru SMPN 1 Anggeraja</p>
            </div>
        </div>
    </div>

    <!-- ================= MAIN APP OBSERVER ================= -->
    <div id="mainApp" class="hidden-screen">
        
        <header class="header-gradient shadow-lg sticky top-0 z-50 no-print">
            <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="bg-white/20 backdrop-blur-sm p-2 rounded-lg">
                        <i class="fas fa-chalkboard-teacher text-white text-lg"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-white text-sm md:text-base leading-tight">Supervisi Coaching</h1>
                        <p class="text-blue-100 text-xs">SMP Negeri 1 Maiwa</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="bg-white/20 backdrop-blur-sm text-white text-xs px-3 py-1.5 rounded-full font-medium hidden md:inline">
                        <i class="fas fa-user-shield mr-1"></i> <span id="headerUser">Kepala Sekolah</span>
                    </span>
                    <button onclick="handleLogout()" class="bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white p-2 rounded-lg transition" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            </div>
        </header>

        <main class="max-w-5xl mx-auto p-4 mb-24">
            
            <div class="flex border-b-2 border-blue-100 mb-5 no-print overflow-x-auto gap-1">
                <button onclick="switchMainMenu('dashboard')" id="menu-dashboard" class="px-5 py-3 text-sm tab-active whitespace-nowrap transition-all">
                    <i class="fas fa-tachometer-alt mr-1"></i> Dashboard
                </button>
                <button onclick="switchMainMenu('guru')" id="menu-guru" class="px-5 py-3 text-sm tab-inactive whitespace-nowrap transition-all">
                    <i class="fas fa-users mr-1"></i> Data Guru
                </button>
                <button onclick="switchMainMenu('rekap')" id="menu-rekap" class="px-5 py-3 text-sm tab-inactive whitespace-nowrap transition-all">
                    <i class="fas fa-chart-bar mr-1"></i> Rekap Supervisi
                </button>
                <button onclick="switchMainMenu('supervisi')" id="menu-supervisi" class="px-5 py-3 text-sm tab-inactive whitespace-nowrap transition-all">
                    <i class="fas fa-clipboard-check mr-1"></i> Sesi Supervisi
                </button>
                <button onclick="switchMainMenu('kredensial')" id="menu-kredensial" class="px-5 py-3 text-sm tab-inactive whitespace-nowrap transition-all">
                    <i class="fas fa-key mr-1"></i> Kredensial
                </button>
            </div>

            <!-- DASHBOARD -->
            <div id="content-dashboard" class="menu-content">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-5">
                    <div class="card-blue p-5">
                        <div class="flex items-center justify-between mb-2">
                            <div class="bg-blue-100 p-2 rounded-lg"><i class="fas fa-users text-blue-600"></i></div>
                        </div>
                        <p class="text-2xl font-bold text-gray-800" id="statTotalGuru">0</p>
                        <p class="text-xs text-gray-500">Total Guru</p>
                    </div>
                    <div class="card-blue p-5">
                        <div class="flex items-center justify-between mb-2">
                            <div class="bg-yellow-100 p-2 rounded-lg"><i class="fas fa-clock text-yellow-600"></i></div>
                        </div>
                        <p class="text-2xl font-bold text-gray-800" id="statPra">0</p>
                        <p class="text-xs text-gray-500">Tahap Pra-Observasi</p>
                    </div>
                    <div class="card-blue p-5">
                        <div class="flex items-center justify-between mb-2">
                            <div class="bg-blue-100 p-2 rounded-lg"><i class="fas fa-eye text-blue-600"></i></div>
                        </div>
                        <p class="text-2xl font-bold text-gray-800" id="statObservasi">0</p>
                        <p class="text-xs text-gray-500">Tahap Observasi</p>
                    </div>
                    <div class="card-blue p-5">
                        <div class="flex items-center justify-between mb-2">
                            <div class="bg-green-100 p-2 rounded-lg"><i class="fas fa-check-circle text-green-600"></i></div>
                        </div>
                        <p class="text-2xl font-bold text-gray-800" id="statSelesai">0</p>
                        <p class="text-xs text-gray-500">Selesai</p>
                    </div>
                </div>

                <div class="card-blue p-5 mb-5">
                    <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-user-tie text-blue-600"></i> Data Observer (Kepala Sekolah)
                    </h3>
                    <div id="observerInfo" class="grid grid-cols-2 gap-3 text-sm">
                        <p class="text-xs text-gray-500 italic col-span-2">Memuat data...</p>
                    </div>
                    <button onclick="openObserverModal()" class="mt-4 text-xs text-blue-600 hover:text-blue-800 font-medium">
                        <i class="fas fa-edit mr-1"></i> Edit Data Observer
                    </button>
                </div>

                <div class="card-blue p-5">
                    <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-bolt text-blue-600"></i> Aksi Cepat
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <button onclick="openGuruModal()" class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white p-4 rounded-xl text-sm font-semibold text-left transition">
                            <i class="fas fa-user-plus mr-2"></i> Tambah Akun Guru Baru
                        </button>
                        <button onclick="switchMainMenu('rekap')" class="bg-gradient-to-r from-blue-50 to-white border border-blue-200 hover:border-blue-400 text-blue-700 p-4 rounded-xl text-sm font-semibold text-left transition">
                            <i class="fas fa-list mr-2"></i> Lihat Rekap Supervisi
                        </button>
                    </div>
                </div>
            </div>

            <!-- DATA GURU -->
            <div id="content-guru" class="menu-content hidden">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="font-bold text-gray-800 text-lg"><i class="fas fa-users text-blue-600 mr-2"></i>Akun Guru</h2>
                    <button onclick="openGuruModal()" class="btn-primary text-white px-4 py-2 rounded-xl text-sm font-semibold">
                        <i class="fas fa-plus mr-1"></i> Tambah Akun
                    </button>
                </div>
                <div class="bg-blue-50 border-l-4 border-blue-500 p-3 rounded-r-lg mb-4 text-xs text-blue-800">
                    <i class="fas fa-info-circle mr-1"></i> <strong>Info:</strong> Anda hanya perlu mendaftarkan <strong>Nama</strong> dan <strong>PIN</strong> guru. Username & data lengkap akan di-generate/diisi otomatis.
                </div>
                <div id="guruList" class="space-y-3">
                    <div class="card-blue p-8 text-center">
                        <div class="spinner mx-auto" style="width: 32px; height: 32px; border-width: 3px;"></div>
                        <p class="text-gray-500 text-sm mt-3">Memuat data guru...</p>
                    </div>
                </div>
            </div>

            <!-- REKAP -->
            <div id="content-rekap" class="menu-content hidden">
                <h2 class="font-bold text-gray-800 text-lg mb-4"><i class="fas fa-chart-bar text-blue-600 mr-2"></i>Rekap Supervisi Guru</h2>
                
                <div class="card-blue p-4 mb-4 flex flex-wrap gap-2 items-center">
                    <span class="text-xs font-medium text-gray-500">Filter Status:</span>
                    <button onclick="filterRekap('all')" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-blue-600 text-white">Semua</button>
                    <button onclick="filterRekap('pra')" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-600">Pra-Observasi</button>
                    <button onclick="filterRekap('observasi')" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-600">Observasi</button>
                    <button onclick="filterRekap('selesai')" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 text-gray-600">Selesai</button>
                </div>

                <div id="rekapList" class="space-y-3"></div>
            </div>

            <!-- SESI SUPERVISI -->
            <div id="content-supervisi" class="menu-content hidden">
                <div class="card-blue p-5 mb-4">
                    <h3 class="font-bold text-gray-800 mb-3"><i class="fas fa-play-circle text-blue-600 mr-2"></i>Mulai Sesi Supervisi</h3>
                    <p class="text-xs text-gray-500 mb-3">Pilih guru yang akan disupervisi untuk membuka form Pra-Observasi, Observasi, dan Pasca-Observasi.</p>
                    <select id="selectGuruSesi" class="w-full text-sm border border-blue-200 rounded-xl p-3 mb-3">
                        <option value="">-- Pilih Guru --</option>
                    </select>
                    <button onclick="startSesi()" class="btn-primary w-full text-white py-3 rounded-xl text-sm font-semibold">
                        <i class="fas fa-arrow-right mr-1"></i> Buka Sesi Supervisi
                    </button>
                </div>

                <div id="sesiAktif" class="hidden">
                    <div class="card-blue p-5 mb-5">
                        <div class="flex justify-between items-center mb-4">
                            <div class="flex items-center gap-2">
                                <div class="bg-blue-100 p-2 rounded-lg"><i class="fas fa-id-card text-blue-600"></i></div>
                                <h2 class="text-sm font-bold text-gray-800 uppercase tracking-wider">Form A: Identitas & Kesepakatan</h2>
                            </div>
                            <span id="sesiStatusBadge" class="status-badge status-pra">Pra-Observasi</span>
                        </div>
                        <div id="formAInfo" class="grid grid-cols-2 gap-3 text-sm"></div>
                    </div>

                    <div class="flex border-b-2 border-blue-100 mb-5 no-print overflow-x-auto gap-1">
                        <button onclick="switchTab('pra')" id="tab-pra" class="px-5 py-3 text-sm tab-active whitespace-nowrap transition-all">
                            <i class="fas fa-clipboard-list mr-1"></i> Pra-Observasi
                        </button>
                        <button onclick="switchTab('observasi')" id="tab-observasi" class="px-5 py-3 text-sm tab-inactive whitespace-nowrap transition-all">
                            <i class="fas fa-eye mr-1"></i> Observasi Kelas
                        </button>
                        <button onclick="switchTab('pasca')" id="tab-pasca" class="px-5 py-3 text-sm tab-inactive whitespace-nowrap transition-all">
                            <i class="fas fa-comments mr-1"></i> Pasca-Observasi
                        </button>
                    </div>

                    <!-- TAB PRA-OBSERVASI -->
                    <div id="content-pra" class="tab-content">
                        <div class="card-blue p-5 mb-4">
                            <div class="flex items-center gap-2 mb-3">
                                <span class="badge-blue">Form B</span>
                                <h3 class="font-bold text-gray-800">Telaah Perencanaan (Modul Ajar/RPP)</h3>
                            </div>
                            <p class="text-xs text-gray-500 mb-4">Lakukan telaah bersama pendidik baru secara dialogis.</p>
                            <div class="space-y-3">
                                <div class="border border-blue-100 rounded-xl p-4 bg-blue-50/30">
                                    <p class="font-semibold text-sm text-blue-800 mb-2"><i class="fas fa-bullseye mr-1"></i> 1. Tujuan Pembelajaran</p>
                                    <textarea id="formB1a" class="w-full text-sm border border-blue-200 rounded-lg p-3 bg-white" rows="2" placeholder="Catatan apresiasi kekuatan..."></textarea>
                                    <textarea id="formB1b" class="w-full text-sm border border-blue-200 rounded-lg p-3 bg-white mt-2" rows="2" placeholder="Catatan pengayaan & diskusi suportif..."></textarea>
                                </div>
